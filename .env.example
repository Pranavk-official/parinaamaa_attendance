# Docker compose reads this. Generate secrets: openssl rand -hex 32

# PostgreSQL (creates the db container; DATABASE_URL must match)
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/attendance"

# Better Auth (>= 32 chars)
BETTER_AUTH_SECRET="change-me-32-chars-minimum-secret"
BETTER_AUTH_URL="http://localhost:3000"

# WFO punch-in IP guard. Optional: leave blank and any signed-in scan of the
# office QR punches in. Set it to the office's public IP to restrict scans.
OFFICE_IP_ADDRESS=""

# Cron endpoint bearer secret
CRON_SECRET="change-me"

# Leave mail goes to neethu@parinaamaa.ai with accounts@parinaamaa.ai in copy
# (see src/lib/leave-mail.ts). Set this only to send to a different address.
MANAGER_EMAIL=""