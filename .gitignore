# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit the example, never real secrets)
.env
.env.*
!.env.example

# generated prisma client
/src/generated/prisma

# local dev setup
/docker-compose.dev.yml

# local editor / tooling state
.windsurf/

# generated by next-pwa at build time
/public/sw.js
/public/workbox-*.js

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
